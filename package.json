{
  "name": "anishbadhri.github.io",
  "version": "1.0.0",
  "description": "Personal portfolio of Anish Badri R S — built with Eleventy and Primer primitives, shipped as static HTML with zero client-side JavaScript.",
  "license": "MIT",
  "author": "Anish Badri R S",
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site build",
    "cv:tex": "node cv/generate.js",
    "cv": "npm run cv:tex && latexmk -pdf -outdir=build/cv build/cv/resume.tex"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@primer/primitives": "^11.9.0",
    "autoprefixer": "^10.4.0",
    "cssnano": "^8.0.0",
    "postcss": "^8.4.0",
    "postcss-import": "^16.0.0",
    "simple-icons": "^16.23.0",
    "zod": "^4.4.3"
  }
}
